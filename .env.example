# Optional public canonical origin, for example https://luminalfactory.com.
NEXT_PUBLIC_APP_BASE_URL=

# Public Commerce Supabase configuration. The publishable key is low-privilege and RLS-backed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Temporary legacy fallback during key migration only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Guest-cart runtime remains disabled until the separate staging/live gate passes.
# SUPABASE_SECRET_KEY is server-only and must use the Commerce project secret key.
COMMERCE_GUEST_CART_ENABLED=false
SUPABASE_SECRET_KEY=
# Exact comma-separated origins only; configure Preview and Production separately.
COMMERCE_GUEST_CART_ALLOWED_ORIGINS=
# At least 32 random characters, server-only. Used to HMAC source rate-limit keys.
COMMERCE_GUEST_CART_RATE_LIMIT_SECRET=

# Permanent customer Auth stays disabled until the isolated OTP/Turnstile staging gate passes.
COMMERCE_CUSTOMER_AUTH_ENABLED=false
COMMERCE_CUSTOMER_AUTH_ALLOWED_ORIGINS=
# At least 32 random characters, server-only. Used to HMAC email/source limiter keys.
COMMERCE_CUSTOMER_AUTH_RATE_LIMIT_SECRET=
# Public Cloudflare Turnstile widget identifier; its secret is configured only in Supabase Auth.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Verified-customer link and guest-cart merge remains disabled until its atomic RPC migration and smoke gate pass.
COMMERCE_CUSTOMER_CART_MERGE_ENABLED=false

# Commission inquiry email transport. Keep all values server-only.
# RESEND_API_KEY requires a Resend API key. COMMISSION_INQUIRY_FROM_EMAIL must use a verified sender/domain.
RESEND_API_KEY=
COMMISSION_INQUIRY_FROM_EMAIL=
COMMISSION_INQUIRY_TO_EMAIL=

# Tooling/operator-only values. Never expose these through NEXT_PUBLIC_*.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Operator-only Vercel Deployment Protection automation bypass for staging probes.
# Never add this value to Preview/Production runtime environment variables.
VERCEL_AUTOMATION_BYPASS_SECRET=
